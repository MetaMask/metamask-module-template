{
  "name": "@metamask/metamask-module-template",
  "version": "0.0.0",
  "description": "The MetaMask Node module template",
  "homepage": "https://github.com/MetaMask/metamask-module-template#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/metamask-module-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/metamask-module-template.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:docs": "typedoc",
    "lint": "yarn lint:oxlint && yarn lint:constraints && yarn lint:misc --check && yarn lint:dependencies --check && yarn lint:changelog",
    "lint:changelog": "auto-changelog validate --formatter oxfmt",
    "lint:constraints": "yarn constraints",
    "lint:dependencies": "yarn lint:dependencies:depcheck && yarn lint:dependencies:dedupe --check",
    "lint:dependencies:depcheck": "depcheck",
    "lint:dependencies:dedupe": "yarn dedupe",
    "lint:dependencies:fix": "yarn lint:dependencies:depcheck && yarn lint:dependencies:dedupe",
    "lint:oxlint": "oxlint .",
    "lint:fix": "yarn lint:oxlint --fix && yarn lint:constraints --fix && yarn lint:misc --write && yarn lint:dependencies:fix && yarn lint:changelog --fix",
    "lint:misc": "oxfmt --ignore-path .gitignore",
    "prepack": "./scripts/prepack.sh",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^5.1.0",
    "@lavamoat/preinstall-always-fail": "^2.0.0",
    "@metamask/auto-changelog": "^6.2.1",
    "@metamask/oxlint-config": "^0.1.1",
    "@metamask/oxlint-config-commonjs": "^0.1.1",
    "@metamask/oxlint-config-nodejs": "^0.1.1",
    "@metamask/oxlint-config-typescript": "^0.1.1",
    "@metamask/oxlint-config-vitest": "^0.1.1",
    "@types/node": "^18.18",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-istanbul": "^4.1.4",
    "@vitest/eslint-plugin": "^1.1.4",
    "@yarnpkg/types": "^4.0.0-rc.52",
    "depcheck": "^1.4.3",
    "eslint-plugin-n": "^18.3.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typedoc": "^0.26.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "resolutions": {
    "fflate": "0.8.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": ">=4.16.0+sha256.ba05224324578801b9cc98170d64aa50b9a36733b440fb0942306da3fbbdc7d1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "packageManager": "yarn@4.18.0+sha256.fb8b1d20be72a0b544a35bcec4c7ed0ff55a9b173c01f191b02ba164b2051db5",
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false
    }
  },
  "scriptsConfig": {
    "#default": "lavamoat/scripts.strict.json",
    "build": "lavamoat/scripts.build.json",
    "lint": "lavamoat/scripts.yarn.json",
    "lint:changelog": "lavamoat/scripts.lint.json",
    "lint:constraints": "lavamoat/scripts.yarn.json",
    "lint:dependencies": "lavamoat/scripts.yarn.json",
    "lint:dependencies:fix": "lavamoat/scripts.yarn.json",
    "lint:dependencies:dedupe": "lavamoat/scripts.yarn.json",
    "lint:oxlint": "lavamoat/scripts.lint.json",
    "lint:fix": "lavamoat/scripts.yarn.json",
    "lint:misc": "lavamoat/scripts.lint.json",
    "prepack": "lavamoat/scripts.yarn.json",
    "test": "lavamoat/scripts.test.json",
    "test:watch": "lavamoat/scripts.test.json"
  }
}
